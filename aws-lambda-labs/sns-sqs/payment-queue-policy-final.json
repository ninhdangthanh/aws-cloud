{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "sns.amazonaws.com" },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:ap-southeast-1:<AWS_ACCOUNT_ID>:PaymentQueue",
      "Condition": {
        "ArnEquals": { "aws:SourceArn": "arn:aws:sns:ap-southeast-1:<AWS_ACCOUNT_ID>:OrderEventsTopic" }
      }
    }
  ]
}